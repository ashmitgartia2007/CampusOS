# CampusOS AI - Frontend Environment Configuration

# Base URL for the Python FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Real-time WebSocket Telemetry Endpoint
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/telemetry

# Fallback mode (true enables local high-fidelity telemetry simulation if backend is offline)
NEXT_PUBLIC_ENABLE_SIMULATION_FALLBACK=true
