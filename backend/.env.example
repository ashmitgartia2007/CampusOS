# CampusOS AI - Backend Environment Configuration

# Database Connection (PostgreSQL or SQLite fallback)
# For local PostgreSQL:
# DATABASE_URL=postgresql://campus_admin:campus_secret@localhost:5432/campusos_db
# For zero-dependency SQLite fallback:
DATABASE_URL=sqlite:///./campusos.db

# JWT Security
JWT_SECRET_KEY=campusos_super_secret_jwt_key_2026_unisphere
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Telemetry Generator
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=4
DATA_SOURCE_LABEL=[SIMULATED TELEMETRY]

# Server Port & Host
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated, no wildcards when credentials enabled)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
